# Names, never values. Kamal reads these from the environment of whoever runs the
# deploy, so a secret lives in a password manager or a CI secret store and never
# in this repository.
#
# The registry password for Yandex Container Registry is an IAM token, which
# expires — it is fetched at deploy time rather than stored:
#
#   export KAMAL_REGISTRY_USERNAME=iam
#   export KAMAL_REGISTRY_PASSWORD=$(yc iam create-token)

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_URL=$DATABASE_URL
WORKROOM_ALLOWED_ORIGINS=$WORKROOM_ALLOWED_ORIGINS

OIDC_ISSUER=$OIDC_ISSUER
OIDC_CLIENT_ID=$OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=$OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=$OIDC_REDIRECT_URI

STORAGE_ENDPOINT=$STORAGE_ENDPOINT
STORAGE_BUCKET=$STORAGE_BUCKET
STORAGE_ACCESS_KEY_ID=$STORAGE_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=$STORAGE_SECRET_ACCESS_KEY

OPENVIKING_URL=$OPENVIKING_URL
OPENVIKING_API_KEY=$OPENVIKING_API_KEY
