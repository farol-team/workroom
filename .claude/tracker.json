{
  "tracker": {
    "provider": "github",
    "repo": "farol-team/workroom"
  },
  "states": {
    "icebox": "flow:icebox",
    "backlog": "flow:backlog",
    "triage": "flow:triage",
    "human_questions": "flow:human-questions",
    "plan_proposed": "flow:plan-proposed",
    "ready": "flow:ready",
    "in_progress": "flow:in-progress",
    "review": "flow:review",
    "blocked": "flow:blocked",
    "done": "flow:done"
  },
  "auto_merge_criteria": {
    "min_confidence": 7,
    "require_ci_green": true,
    "max_risk": "medium",
    "strategy": "squash"
  },
  "research": {
    "marker": "[research]",
    "doc_dir": "docs/spikes",
    "target_repo": ".",
    "route": "review"
  },
  "epic": {
    "marker": "[epic]",
    "label_prefix": "epic:",
    "auto_refresh_checklist": true,
    "auto_create_min_cluster": 3
  },
  "labels": {
    "ai_generated": "ai"
  },
  "worker": {
    "max_turns": 100,
    "model": "",
    "resume_sessions": true
  },
  "acceptance": {
    "max_turns": 50,
    "model": ""
  },
  "tdd_gate": {
    "enabled": true,
    "min_size": "M",
    "min_risk": "medium",
    "max_spec_iterations": 2
  },
  "split_confirmation_phrase": "split confirmed",
  "card_prefix": "WR",
  "branch_prefix": "flow/",
  "default_target": "server",
  "repo_label_prefix": "target:",
  "targets": {
    "server": {
      "repo_root": "server",
      "worktree_root": ".flow/worktrees",
      "worker_log_dir": ".flow/worker-logs",
      "branch_prefix": "flow/",
      "toolchain": "rails",
      "test_cmd": "bin/rails test <path>",
      "lint_cmd": "bin/rubocop <path>"
    },
    "desktop": {
      "repo_root": "desktop",
      "worktree_root": ".flow/worktrees",
      "worker_log_dir": ".flow/worker-logs",
      "branch_prefix": "flow/",
      "toolchain": "node",
      "test_cmd": "pnpm exec tsc --noEmit",
      "lint_cmd": "pnpm build"
    },
    "docs": {
      "repo_root": ".",
      "worktree_root": ".flow/worktrees",
      "worker_log_dir": ".flow/worker-logs",
      "branch_prefix": "flow/",
      "toolchain": "docs",
      "test_cmd": "",
      "lint_cmd": ""
    }
  },
  "project_context_docs": [
    "README.md",
    "docs/ARCHITECTURE.md",
    "docs/MEMORY.md",
    "docs/AGENTS.md",
    "docs/RAIL.md"
  ],
  "session_log": ".flow/session-log.md",
  "learnings": ".claude/learnings.jsonl",
  "comment_prefixes": {
    "meta": "[meta] ",
    "worker": "[worker] "
  },
  "comment_signature": "\n\n\u2014 Farol AI Agent Flow"
}
