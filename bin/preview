#!/usr/bin/env bash
# Look at the interface.
#
# Renders the built client against a running server with the native bridge
# stubbed, and writes a picture of each state worth seeing.
#
#   bin/prototype        # in another terminal
#   bin/preview
#
# Everything shipped into this client for weeks was tested and unseen. The first
# time anybody looked, two defects turned up in half an hour (#65, #66): a panel
# that had never been hidden, and a room that never opened when the bridge was
# silent. Neither was reachable by any test.
set -euo pipefail
cd "$(dirname "$0")/.."

SERVER="${WORKROOM_SERVER:-http://127.0.0.1:3000}"
OUT="${WORKROOM_SHOTS:-$PWD/tmp/preview}"
PORT="${WORKROOM_PREVIEW_PORT:-4173}"

say()  { printf '\033[36m→ %s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

curl -sf "$SERVER/up" >/dev/null 2>&1 || fail "No server on $SERVER. Start one with bin/prototype."

BROWSER="${WORKROOM_BROWSER:-}"
if [ -z "$BROWSER" ]; then
  BROWSER=$(command -v chromium || command -v chromium-browser || command -v google-chrome || true)
  [ -z "$BROWSER" ] && BROWSER=$(ls -d "$HOME"/.cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-*/chrome-headless-shell 2>/dev/null | head -1 || true)
  # The installed apps, last: they work, but branded Chrome renders and then
  # stays (headless is a mode, not an exit), which is what the watchdog in
  # render() is for.
  [ -z "$BROWSER" ] && BROWSER=$(ls -d \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Chromium.app/Contents/MacOS/Chromium" 2>/dev/null | head -1 || true)
fi
[ -n "$BROWSER" ] || fail "No headless browser found. Set WORKROOM_BROWSER to one."

say "building the client"
(cd desktop && pnpm --silent build >/dev/null)

STAGE=$(mktemp -d)
PROFILE=$(mktemp -d)
trap 'kill %1 2>/dev/null || true; rm -rf "$STAGE" "$PROFILE"' EXIT

cp -r desktop/dist/. "$STAGE/"
cp desktop/preview/bridge.js "$STAGE/bridge.js"
python3 - "$STAGE/index.html" <<'INJECT'
import sys, pathlib
page = pathlib.Path(sys.argv[1])
page.write_text(page.read_text().replace("</head>", '<script src="/bridge.js"></script></head>'))
INJECT

# Threaded, deliberately. `python3 -m http.server` answers one request at a time
# and a browser opens several at once, so the page arrives without its script and
# it reads as flakiness rather than as a one-request-at-a-time server.
cat > "$STAGE/serve.py" <<'SERVE'
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
ThreadingHTTPServer(("127.0.0.1", int(sys.argv[1])), SimpleHTTPRequestHandler).serve_forever()
SERVE

say "serving it with the bridge stubbed"
(cd "$STAGE" && exec python3 serve.py "$PORT" >/dev/null 2>&1) &

# It must be *ours* on that port. A stale server left by an earlier run serves a
# directory that no longer exists, the browser renders its own error page, and
# every picture comes out empty for no visible reason.
for _ in $(seq 20); do
  curl -sf "http://127.0.0.1:$PORT/bridge.js" >/dev/null 2>&1 && break
  sleep 0.5
done
curl -sf "http://127.0.0.1:$PORT/bridge.js" >/dev/null 2>&1 \
  || fail "Something else is on port $PORT. Set WORKROOM_PREVIEW_PORT."

# One browser for all the pictures, driven over CDP by
# `desktop/preview/shoot.mjs`. Process exit cannot be the signal a render
# finished (branded Chrome renders, prints, and stays — headless is a mode,
# not an exit), and the CLI flags cannot ask the page whether it is ready:
# `--dump-dom` fires at load, before the boot chain's fetches land, and
# `--virtual-time-budget` does not pause for them. CDP can ask, so "ready" is
# what it actually is — the DOM containing what the state is meant to show.
DEBUG_PORT=$(( 20000 + RANDOM % 20000 ))
"$BROWSER" --headless --disable-gpu --no-sandbox --hide-scrollbars \
  --no-first-run --no-default-browser-check --disable-background-networking \
  --disable-component-update --disable-sync \
  --user-data-dir="$PROFILE" --remote-debugging-port="$DEBUG_PORT" \
  about:blank >/dev/null 2>&1 &
# The browser outlives its kill signal by a beat, still writing its cache —
# give it the beat, and let a stubborn remnant go rather than fail the run
# over a temp directory.
trap 'kill %1 %2 2>/dev/null || true; sleep 1; rm -rf "$STAGE" "$PROFILE" 2>/dev/null || true' EXIT

for _ in $(seq 20); do
  curl -sf "http://127.0.0.1:$DEBUG_PORT/json/version" >/dev/null 2>&1 && break
  sleep 0.5
done
curl -sf "http://127.0.0.1:$DEBUG_PORT/json/version" >/dev/null 2>&1 \
  || fail "The browser never opened its debugging port on $DEBUG_PORT."

mkdir -p "$OUT"

say "looking"
node desktop/preview/shoot.mjs "$DEBUG_PORT" "http://127.0.0.1:$PORT/" "$OUT" '[
  { "name": "signed-out", "query": "&signed-in=no", "want": "Sign in" },
  { "name": "room",       "query": "",              "want": "class=\"msg" },
  { "name": "memory",     "query": "&open=memory",  "want": "<aside id=\"memory\">" },
  { "name": "thread",     "query": "&open=thread",  "want": "<aside id=\"thread\">" },
  { "name": "channel-settings",         "query": "&open=channel-settings",         "want": "Channel settings" },
  { "name": "channel-settings-warning", "query": "&open=channel-settings-warning", "want": "deploys on merge" }
]'

say "written to $OUT"
