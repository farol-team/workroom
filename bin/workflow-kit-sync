#!/usr/bin/env bash
# Sync the agent-workflow kit into the current repo's .claude/.
#
# Kit-owned (overwritten, deletions propagate): .claude/{commands,prompts,hooks,bin,providers}
# Project-owned (never touched): .claude/tracker.json, .claude/constitution.md,
#   .claude/project-context.md, .claude/settings.local.json,
#   .claude/learnings.jsonl (committed project memory),
#   .claude/prompts/ui-design.md (optional per-project UI guide).
#
# Usage: bin/workflow-kit-sync            # sync from main
#        KIT_REF=<branch|sha> bin/workflow-kit-sync
# Requires: gh (authenticated), git, rsync, jq.
#
# Exit codes: 0 = synced; 2 = synced, but .claude/tracker.json failed the
# contract check (missing required keys, or not valid JSON) — fix before
# committing.
set -euo pipefail

KIT_REPO="${KIT_REPO:-farol-team/agent-flow}"
KIT_REF="${KIT_REF:-main}"
ROOT="$(git rev-parse --show-toplevel)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

gh repo clone "$KIT_REPO" "$TMP/kit" -- --depth 1 --branch "$KIT_REF" --quiet
REV="$(git -C "$TMP/kit" rev-parse --short HEAD)"

rsync -a --delete "$TMP/kit/kit/commands/" "$ROOT/.claude/commands/"
rsync -a --delete --exclude ui-design.md "$TMP/kit/kit/prompts/" "$ROOT/.claude/prompts/"
rsync -a --delete "$TMP/kit/kit/hooks/" "$ROOT/.claude/hooks/"
chmod +x "$ROOT/.claude/hooks/"*.sh
if [ -d "$TMP/kit/kit/bin" ]; then
  rsync -a --delete "$TMP/kit/kit/bin/" "$ROOT/.claude/bin/"
  find "$ROOT/.claude/bin" -type f -exec chmod +x {} +
fi
if [ -d "$TMP/kit/kit/providers" ]; then
  rsync -a --delete "$TMP/kit/kit/providers/" "$ROOT/.claude/providers/"
fi

if [ -f "$ROOT/.claude/trello.json" ] && [ ! -f "$ROOT/.claude/tracker.json" ]; then
  echo "note: found .claude/trello.json — the kit config moved to .claude/tracker.json (tracker-agnostic): rename it, wrap the board block as {\"tracker\":{\"provider\":\"trello\",\"board\":{...}}} and rename \"lists\" to \"states\" (see docs/tracker.example.trello.json in $KIT_REPO)." >&2
fi

if [ -f "$ROOT/.gilb/learnings.jsonl" ]; then
  echo "note: found .gilb/learnings.jsonl — the kit default moved to .claude/learnings.jsonl (committed, so project memory travels with the repo). Move the file and update the 'learnings' key in tracker.json." >&2
fi

{
  printf '%s %s %s\n' "$KIT_REPO" "$KIT_REF" "$REV"
  # What the kit-owned trees contain right now. bin/kit-verify recomputes this,
  # so an edit made here after a sync is visible before the next sync deletes it.
  printf 'digest %s\n' "$("$ROOT/bin/kit-digest" "$ROOT")"
} > "$ROOT/.claude/KIT_REVISION"

echo "Kit synced from $KIT_REPO@$KIT_REF ($REV)."
echo "Changes (empty = already in sync):"
git -C "$ROOT" status --short -- .claude/ || true

# Config contract: the kit commands read a fixed set of top-level keys from
# .claude/tracker.json. A kit update can grow that set; syncing prompts
# without the new keys leaves commands reading defaults the consumer never
# reviewed. Fail loudly (exit 2) — the file sync above has already happened.
CONTRACT="$TMP/kit/kit/config-contract.txt"
CONF="$ROOT/.claude/tracker.json"
if ! command -v jq >/dev/null 2>&1; then
  echo "WARNING: jq not found — skipping the tracker.json contract check (jq is a kit requirement)." >&2
elif [ ! -f "$CONTRACT" ]; then
  echo "note: kit has no config-contract.txt at $KIT_REF — contract check skipped." >&2
elif [ ! -f "$CONF" ]; then
  echo "WARNING: no .claude/tracker.json yet — create it from docs/tracker.example.trello.json (adoption step 3)." >&2
elif ! jq empty "$CONF" >/dev/null 2>&1; then
  echo "ERROR: .claude/tracker.json is not valid JSON — fix it, then re-run the contract check." >&2
  exit 2
else
  MISSING=""
  while IFS= read -r raw || [ -n "$raw" ]; do
    # Normalize: strip surrounding whitespace, then skip blanks/comments —
    # a cosmetically-valid contract edit must not break consumer syncs.
    key="$(printf '%s' "$raw" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    case "$key" in ''|\#*) continue ;; esac
    jq -e --arg k "$key" 'has($k)' "$CONF" >/dev/null 2>&1 || MISSING="$MISSING $key"
  done < "$CONTRACT"
  if [ -n "$MISSING" ]; then
    echo "" >&2
    echo "ERROR: .claude/tracker.json is missing required top-level keys:$MISSING" >&2
    echo "Kit commands read them. Add them before committing this sync" >&2
    echo "(reference values: docs/tracker.example.trello.json in $KIT_REPO)." >&2
    exit 2
  fi
fi
